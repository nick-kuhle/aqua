# Aqua — BNB process (first CoW production). One process per chain.
CHAIN_ID=56
BNB_HTTP_URL=
BNB_WS_URL=

MOUTH_COW=true
COW_SOLVE_BIND=127.0.0.1:8181
MOUTH_UNISWAPX=false

# Sidecar is not v1 on BNB
STRATEGY_LIQUIDATION_MORPHO=false
STRATEGY_LIQUIDATION_AAVE=false
STRATEGY_ORACLE_BACKRUN=false
STRATEGY_ATOMIC_ARB=true

BRIBE_BPS=0
SUBMISSION_MODE=cow_driver
