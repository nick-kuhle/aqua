# Aqua — BNB candidate process. One process per chain. Do not arm until current
# CoW onboarding/driver terms and this profile's registry entries are verified.
CHAIN_ID=56
BNB_HTTP_URL=
BNB_WS_URL=

MOUTH_COW=true
COW_SOLVE_BIND=127.0.0.1:8181
MOUTH_UNISWAPX=false

# Sidecar is not v1 on BNB
STRATEGY_LIQUIDATION_MORPHO_BLUE=false
STRATEGY_LIQUIDATION_MORPHO_V2=false
STRATEGY_LIQUIDATION_AAVE_V3=false
STRATEGY_LIQUIDATION_AAVE_V4=false
STRATEGY_ORACLE_BACKRUN_UNCOVERED=false
STRATEGY_OEV_AUCTION_SVR=false
STRATEGY_ATOMIC_ARB=true

BRIBE_BPS=0
# Transport: CoW driver settles; Aqua holds no submission transport here.
TRANSPORT_PUBLIC_RAW=false
TRANSPORT_PRIVATE_RAW=false
TRANSPORT_BUNDLE=false
TRANSPORT_SEQUENCER_RAW=false
QUALIFICATION_BACKEND=solver-auction

LIVE_EXECUTION=false
BROADCAST_ENABLED=false
LIVE_SMOKE_MAX=0

API_BIND=127.0.0.1:8180
