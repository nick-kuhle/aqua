# Aqua — Base process. Sequencer chain: no public mempool, no bundle market.
CHAIN_ID=8453
BASE_HTTP_URL=
BASE_WS_URL=
# FLASHBLOCKS_WS_URL=     # phase 4

MOUTH_COW=true
COW_SOLVE_BIND=127.0.0.1:8281
MOUTH_UNISWAPX=false

# Lending unregistered until Ethereum sidecar has evidence
STRATEGY_LIQUIDATION_MORPHO_BLUE=false
STRATEGY_LIQUIDATION_MORPHO_V2=false
STRATEGY_LIQUIDATION_AAVE_V3=false
STRATEGY_LIQUIDATION_AAVE_V4=false
STRATEGY_ORACLE_BACKRUN_UNCOVERED=false
STRATEGY_OEV_AUCTION_SVR=false
STRATEGY_ATOMIC_ARB=true
DEX_UNIV3_ARB=true
DEX_AERODROME_VOLATILE=false

BRIBE_BPS=0
# Transport: sequencer raw only. No bundle market on an OP-stack sequencer.
TRANSPORT_SEQUENCER_RAW=true
TRANSPORT_BUNDLE=false
TRANSPORT_ENDPOINTS_MAX=1
QUALIFICATION_BACKEND=sequencer
REFORK_EVERY_BLOCKS=6
LIVE_SMOKE_MAX=0
LIVE_SMOKE_MAX_GAS_COST_WEI=0
RAW_CANCEL_MAX_FEE_WEI=500000000000

LIVE_EXECUTION=false
BROADCAST_ENABLED=false

API_BIND=127.0.0.1:8280
