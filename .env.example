# Aqua — copy to .env. Never commit secrets.
# Names are wei or bps. Forbidden aliases (MIN_NET_PROFIT_ETH, MAX_BASE_FEE_GWEI,
# MAX_DRAWDOWN_ETH, BUILDER_SHARE_BPS) refuse boot. See docs/CONFIG.md.

CHAIN_ID=1
ETH_HTTP_URL=
ETH_WS_URL=

# Mouths
MOUTH_COW=true
COW_SOLVE_BIND=127.0.0.1:8081
MOUTH_UNISWAPX=false
MOUTH_7683=false
MIN_FILL_BPS=5
OPT_BUDGET_MS=800

# Sidecar
STRATEGY_LIQUIDATION_MORPHO=true
STRATEGY_LIQUIDATION_AAVE=true
STRATEGY_LIQUIDATION_COMPOUND=false
STRATEGY_LIQUIDATION_MAKER=false
STRATEGY_ORACLE_BACKRUN=true
STRATEGY_ATOMIC_ARB=true
TOKEN_VALUATION=false
VALUATION_HAIRCUT_BPS=200

# DEX
ARB_MAX_CYCLE_LEN=3
ARB_ENUMERATION_BUDGET_MS=25
ARB_MAX_POOLS=200
DEX_UNIV3_ARB=true
DEX_AERODROME_VOLATILE=false
POOL_DISCOVERY_V3=true

# Risk — liberal for measurement. Tighten before arming.
MIN_NET_PROFIT_WEI=1
MAX_POSITION_WEI=100000000000000000000
MAX_BASE_FEE_WEI=500000000000
BRIBE_BPS=9000
MAX_GAS_PER_BUNDLE=3000000
MAX_DRAWDOWN_WEI=0
MAX_INFLIGHT_PER_STRATEGY=32

# Live — all off
LIVE_EXECUTION=false
# I_UNDERSTAND_LIVE_RISK=yes
BROADCAST_ENABLED=false
LIVE_SMOKE_MAX=0
LIVE_SMOKE_MAX_GAS_COST_WEI=0
QUALIFICATION_WINDOW_HOURS=168

# Keys — never commit. Sidecar ≠ intent ≠ owner ≠ relay reputation.
# SIDECAR_SEARCHER_PRIVATE_KEY=
# INTENT_SEARCHER_PRIVATE_KEY=
# RELAY_REPUTATION_PRIVATE_KEY=

API_BIND=127.0.0.1:8080
# API_AUTH_TOKEN=   # required if API_BIND is not loopback
