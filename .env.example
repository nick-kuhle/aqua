# Aqua — copy to .env. Never commit secrets.
# Names are wei or bps. Forbidden aliases refuse boot (see docs/CONFIG.md):
# MIN_NET_PROFIT_ETH, MAX_BASE_FEE_GWEI, MAX_DRAWDOWN_ETH, BUILDER_SHARE_BPS,
# SUBMISSION_MODE, STRATEGY_LIQUIDATION_AAVE, STRATEGY_LIQUIDATION_MORPHO,
# STRATEGY_ORACLE_BACKRUN.

CHAIN_ID=1
ETH_HTTP_URL=
ETH_WS_URL=
# PROTOCOL_REGISTRY_PATH=   # required for any live-capable profile

# Mouths
MOUTH_COW=true
COW_SOLVE_BIND=127.0.0.1:8081
MOUTH_UNISWAPX=false
MOUTH_7683=false
MIN_FILL_BPS=5
OPT_BUDGET_MS=800

# Sidecar — version-specific rows. v3 and v4 are different math.
STRATEGY_LIQUIDATION_MORPHO_BLUE=true
STRATEGY_LIQUIDATION_MORPHO_V2=false
STRATEGY_LIQUIDATION_AAVE_V3=true
STRATEGY_LIQUIDATION_AAVE_V4=false
STRATEGY_LIQUIDATION_COMPOUND=false
STRATEGY_LIQUIDATION_MAKER=false

# Oracle rows — coverage decides which one is even eligible.
# unknown coverage disables both. See docs/SIDECAR.md.
STRATEGY_ORACLE_BACKRUN_UNCOVERED=true
STRATEGY_OEV_AUCTION_SVR=false
MAX_OEV_BID_BPS=0
MAX_ORDERING_BID_BPS=0

STRATEGY_ATOMIC_ARB=true
TOKEN_VALUATION=false
VALUATION_HAIRCUT_BPS=200

# DEX
ARB_MAX_CYCLE_LEN=3
ARB_ENUMERATION_BUDGET_MS=25
ARB_MAX_POOLS=200
DEX_UNIV3_ARB=true
DEX_AERODROME_VOLATILE=false
POOL_DISCOVERY_V3=true

# Simulation — revm screens, Anvil decides. Authority cannot be revm.
SIM_SCREEN_BACKEND=revm
SIM_AUTHORITY_BACKEND=anvil
SIM_DIFFERENTIAL_SAMPLE_BPS=10000

# Transport — no generic send. Each variant is its own adapter.
TRANSPORT_PUBLIC_RAW=false
TRANSPORT_PRIVATE_RAW=false
TRANSPORT_BUNDLE=false
TRANSPORT_BUNDLE_MERGEABLE=false
TRANSPORT_OEV_AUCTION=false
TRANSPORT_EXPRESS_LANE=false
TRANSPORT_SEQUENCER_RAW=false
TRANSPORT_ENDPOINTS_MAX=1
# BUNDLE_REFUND_PERCENT=      # 1-99; refunds are receivable, never revenue
# BUNDLE_REFUND_RECIPIENT=    # must be an attested Aqua-controlled address
BUNDLE_DROPPING_TX_ALLOWED=false

# Risk — liberal for measurement. Tighten before arming.
MIN_NET_PROFIT_WEI=1
MAX_POSITION_WEI=100000000000000000000
MAX_BASE_FEE_WEI=500000000000
BRIBE_BPS=9000
MAX_GAS_PER_BUNDLE=3000000
MAX_DRAWDOWN_WEI=0
MAX_INFLIGHT_PER_STRATEGY=32

# Live — all off
LIVE_EXECUTION=false
# I_UNDERSTAND_LIVE_RISK=yes
BROADCAST_ENABLED=false
LIVE_SMOKE_MAX=0
LIVE_SMOKE_MAX_GAS_COST_WEI=0
QUALIFICATION_WINDOW_HOURS=168

# Keys — never commit. Sidecar ≠ intent ≠ owner ≠ relay reputation.
# Splitting submissions across identities to farm refunds is prohibited.
# SIDECAR_SEARCHER_PRIVATE_KEY=
# INTENT_SEARCHER_PRIVATE_KEY=
# RELAY_REPUTATION_PRIVATE_KEY=

API_BIND=127.0.0.1:8080
# API_AUTH_TOKEN=   # required if API_BIND is not loopback
